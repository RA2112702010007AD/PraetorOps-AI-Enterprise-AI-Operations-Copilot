# PraetorOps AI — Environment Configuration Example
# Copy to .env for local overrides. Never commit actual secrets to version control.

# Application Server Settings
ENVIRONMENT=demo
DEBUG=false
HOST=0.0.0.0
PORT=8000

# Google Cloud Platform & Vertex AI Settings
GCP_PROJECT=prj-praetorops-ai-demo
GCP_REGION=us-central1
GEMINI_MODEL=gemini-1.5-pro
EMBEDDING_MODEL=text-embedding-004

# Gemini API Key (Server-side boundary only; never exposed to browser)
GEMINI_API_KEY=your_gemini_api_key_here

# Multi-Tenant & Governance Settings
DEFAULT_TENANT_ID=tenant_acme
ENABLE_PROMPT_INJECTION_SHIELD=true
GROUNDING_THRESHOLD=0.85
